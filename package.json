{
  "name": "wechat-claw",
  "version": "1.0.0",
  "description": "Wechat group listener for structured business summaries",
  "type": "module",
  "main": "dist/app/bootstrap.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --loader ts-node/esm src/app/bootstrap.ts",
    "doctor": "node --loader ts-node/esm src/app/doctor.ts",
    "inspect:messages": "node --loader ts-node/esm src/app/inspect-recent-messages.ts",
    "postinstall": "node scripts/patch-wechaty-puppet-wechat.mjs",
    "start": "node dist/app/bootstrap.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.6.1",
    "qrcode-terminal": "^0.12.0",
    "wechaty": "^1.20.2",
    "wechaty-puppet-wechat": "^1.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
