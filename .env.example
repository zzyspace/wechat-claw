# =========================
# 微信接入方式
# =========================

# 普通微信 web 模式：
#   wechaty-puppet-wechat
# 企业微信 / service 模式：
#   wechaty-puppet-service
WECHATY_PUPPET=wechaty-puppet-wechat

# 仅 service 模式需要填写，web 模式留空即可
WECHATY_PUPPET_SERVICE_TOKEN=

# web 模式建议开启 UOS 兼容分支，二维码/登录更稳定
# 可选值：1 / true / 空
WECHATY_PUPPET_WECHAT_PUPPETEER_UOS=1


# =========================
# Bot 基础配置
# =========================

# 本地 bot 名称
WECHATY_BOT_NAME=wechat-loss-bot

# 运行状态目录：
#   - SQLite
#   - 图片附件
#   - 最新二维码
#   - health.json
#   - memory-card 登录态
WECHATY_STATE_DIR=/var/lib/wechat-claw

# 报损日期边界和定时任务统一使用的时区
WECHATY_TIMEZONE=Asia/Shanghai

# 所有 [wechat-claw] 调试信息统一发给这个联系人
# 例如：上线通知、收到群消息的调试摘要
WECHATY_DEBUG_CONTACT_NAME=你的主微信昵称

# 推荐使用多 channel JSON 配置
# 当前支持：
#   - match.type: room_topic
#   - deliveryTargets.type: contact_name / room_topic
# 注意：这是 .env 里的单行 JSON
WECHATY_CHANNELS_JSON=[{"code":"loss_a","enabled":true,"scenario":"loss-report","match":{"type":"room_topic","value":"AI测试群A"},"deliveryTargets":[{"type":"contact_name","value":"你的主微信昵称"},{"type":"room_topic","value":"AI测试日报群A"}],"summarySchedule":"0 22 * * *"},{"code":"loss_b","enabled":true,"scenario":"loss-report","match":{"type":"room_topic","value":"AI测试群B"},"deliveryTargets":[{"type":"contact_name","value":"你的主微信昵称"}],"summarySchedule":"0 22 * * *"}]

# 兼容旧版单群配置，未配置 WECHATY_CHANNELS_JSON 时才会回退使用
WECHATY_TARGET_ROOM_TOPIC=
WECHATY_DELIVERY_CONTACT_NAME=


# =========================
# 日报汇总配置
# =========================

# 兼容旧版单群配置的默认日报周期
# 当使用 WECHATY_CHANNELS_JSON 时，建议在每个 channel 的 summarySchedule 里单独配置
WECHATY_SUMMARY_CRON=0 22 * * *

# 同一人在多少秒内连续发送的图文消息，合并成一条报损
# 例如：
#   5   表示 5 秒内图文会合并
#   60  表示 60 秒内图文会合并
# 当前规则：
#   - 图 + 文字：可在窗口内合并
#   - 图 + 图：不合并
#   - 一条报损最多只会保留一张图片
WECHATY_LOSS_MERGE_WINDOW_SECONDS=60

# 自定义日报提示词模板
# 留空时走代码默认模板
# 如果你要改成单行，注意不要随便带引号
WECHATY_SUMMARY_PROMPT_TEMPLATE=


# =========================
# 报损提取模型配置
# =========================

# 报损提取模型提供商
# 当前已接入：
#   qwen
WECHATY_LOSS_EXTRACTION_PROVIDER=qwen

# 报损提取模型名
# 推荐：
#   qwen3-vl-flash
WECHATY_LOSS_EXTRACTION_MODEL=qwen3-vl-flash

# 百炼 / DashScope API Key
WECHATY_LOSS_EXTRACTION_API_KEY=

# Qwen OpenAI 兼容接口地址
WECHATY_LOSS_EXTRACTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
