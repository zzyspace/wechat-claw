# =========================
# 微信接入方式
# =========================

# 普通微信 web 模式：
#   wechaty-puppet-wechat
# 企业微信 / service 模式：
#   wechaty-puppet-service
WECHATY_PUPPET=wechaty-puppet-wechat

# 仅 service 模式需要填写，web 模式留空即可
WECHATY_PUPPET_SERVICE_TOKEN=

# web 模式建议开启 UOS 兼容分支，二维码/登录更稳定
# 可选值：1 / true / 空
WECHATY_PUPPET_WECHAT_PUPPETEER_UOS=1


# =========================
# Bot 基础配置
# =========================

# 本地 bot 名称
WECHATY_BOT_NAME=wechat-loss-bot

# 运行状态目录：
#   - SQLite
#   - 图片附件
#   - logs/ 文本日志
#   - 最新二维码
#   - health.json
#   - memory-card 登录态
WECHATY_STATE_DIR=/var/lib/wechat-claw

# 日志目录，默认会自动拼成 ${WECHATY_STATE_DIR}/logs
WECHATY_LOG_DIR=/var/lib/wechat-claw/logs

# 文本日志保留天数
# 启动后会先清理一次，并在后台定期清理更早的历史日志文件
WECHATY_LOG_RETENTION_DAYS=7

# 日志级别：
#   debug / info / warn / error
WECHATY_LOG_LEVEL=info

# 是否记录完整的 wechaty 原始消息快照
# 生产环境建议关闭，排障时临时打开
WECHATY_DEBUG_MESSAGE_SNAPSHOT_ENABLED=false

# 报损日期边界和定时任务统一使用的时区
WECHATY_TIMEZONE=Asia/Shanghai

# 所有 [wechat-claw] 调试信息统一发给这个联系人
# 例如：上线通知
WECHATY_DEBUG_CONTACT_NAME=你的主微信昵称

# 报账查看后台监听地址
# 建议只监听本机，再通过 Nginx 暴露 /reimbursement
WECHATY_ADMIN_HOST=127.0.0.1
WECHATY_ADMIN_PORT=8788
WECHATY_ADMIN_USERNAME=
WECHATY_ADMIN_PASSWORD=

# 下面两个变量只给 deploy 脚本使用：
# - WECHATY_ADMIN_NGINX_SITE_NAME: 要把 /reimbursement 挂到哪个现有 Nginx site
# - WECHATY_ADMIN_NGINX_HEALTHZ_URL: deploy 完成后，用哪个 Nginx URL 校验外网入口
# 默认按 invoice-submit 的 server 配置：
WECHATY_ADMIN_NGINX_SITE_NAME=invoice-submit
WECHATY_ADMIN_NGINX_HEALTHZ_URL=http://127.0.0.1:8080/reimbursement/healthz

# 是否发送 "[wechat-claw] 已收到群消息" 这类调试摘要
WECHATY_DEBUG_RECEIVED_ROOM_MESSAGE_ENABLED=false

# raw 图片附件保留天数（报损 raw 与报账 reimbursement/raw 都会清理）
# 启动后会先清理一次，并在后台定期清理更早的历史目录
# 设为 0 可关闭
WECHATY_ATTACHMENT_RETENTION_DAYS=60

# 冷启动忽略窗口，单位秒
# 会忽略发送时间早于“bot 启动时间 - 窗口”的历史消息
# 设为 0 可关闭
WECHATY_COLD_START_IGNORE_WINDOW_SECONDS=60

# 异常告警邮件开关
WECHATY_ALERT_EMAIL_ENABLED=false

# SMTP 配置
# 常见组合：
#   587 + false  表示明文连接后尝试 STARTTLS
#   465 + true   表示直接 TLS
WECHATY_ALERT_SMTP_HOST=smtp.example.com
WECHATY_ALERT_SMTP_PORT=587
WECHATY_ALERT_SMTP_SECURE=false
WECHATY_ALERT_SMTP_USERNAME=bot@example.com
WECHATY_ALERT_SMTP_PASSWORD=
WECHATY_ALERT_EMAIL_FROM=bot@example.com

# 多个收件人用逗号分隔
WECHATY_ALERT_EMAIL_TO=ops@example.com

# watchdog 内存阈值，单位 MiB
# 设为 0 可关闭；2GiB 机器建议先用 512
WECHATY_WATCHDOG_MEMORY_LIMIT_MB=512

# 内存阈值持续多久才触发重启，单位秒
WECHATY_WATCHDOG_MEMORY_PERSISTENCE_SECONDS=300

# 是否启用“文件传输助手”自检 canary
WECHATY_SELF_CANARY_ENABLED=false

# 自检发送目标联系人，建议先用“文件传输助手”
WECHATY_SELF_CANARY_TARGET_CONTACT_NAME=文件传输助手

# 自检发送间隔，单位秒
# 支持单值：1800
# 也支持范围：1800-2700，表示每轮随机挑一个秒数
WECHATY_SELF_CANARY_INTERVAL_SECONDS=1800-2700

# 发送后等待 self message 回流的超时时间，单位秒
WECHATY_SELF_CANARY_ACK_TIMEOUT_SECONDS=120

# 连续失败多少次才算 canary 故障
WECHATY_SELF_CANARY_FAILURE_THRESHOLD=2

# 连续失败达到阈值后，是否自动备份并停用 memory-card 后触发 fresh login
# 建议先设为 false 观察 filehelper 回流是否稳定
WECHATY_SELF_CANARY_AUTO_RESET_ENABLED=false

# 是否启用群消息链路自检 canary
# 建议使用低打扰测试群，例如 AI报账群
WECHATY_ROOM_CANARY_ENABLED=false

# 群自检发送目标群名，必须是 bot 可找到的 room topic
WECHATY_ROOM_CANARY_TARGET_ROOM_TOPIC=AI报账群

# 群自检发送间隔，单位秒；支持单值或范围
WECHATY_ROOM_CANARY_INTERVAL_SECONDS=600-1200

# 发送后等待自身群消息回流的超时时间，单位秒
WECHATY_ROOM_CANARY_ACK_TIMEOUT_SECONDS=120

# 连续失败多少次才判断群消息监听卡住
WECHATY_ROOM_CANARY_FAILURE_THRESHOLD=2

# 连续失败达到阈值后，是否自动重启 wechat-claw
WECHATY_ROOM_CANARY_AUTO_RESTART_ENABLED=false

# 推荐使用多 channel JSON 配置
# 当前支持：
#   - scenario: loss-report / reimbursement
#   - match.type: room_topic
#   - deliveryTargets.type: contact_name / room_topic
# 注意：这是 .env 里的单行 JSON
WECHATY_CHANNELS_JSON=[{"code":"loss_a","enabled":true,"scenario":"loss-report","match":{"type":"room_topic","value":"AI测试群A"},"deliveryTargets":[{"type":"contact_name","value":"你的主微信昵称"},{"type":"room_topic","value":"AI测试日报群A"}],"summarySchedule":"0 22 * * *"},{"code":"reimbursement_a","enabled":true,"scenario":"reimbursement","match":{"type":"room_topic","value":"AI报账群A"},"deliveryTargets":[],"summarySchedule":""}]

# 兼容旧版单群配置，未配置 WECHATY_CHANNELS_JSON 时才会回退使用
WECHATY_TARGET_ROOM_TOPIC=
WECHATY_DELIVERY_CONTACT_NAME=


# =========================
# 日报汇总配置
# =========================

# 兼容旧版单群配置的默认日报周期
# 当使用 WECHATY_CHANNELS_JSON 时，建议在每个 channel 的 summarySchedule 里单独配置
WECHATY_SUMMARY_CRON=0 22 * * *

# 同一人在多少秒内连续发送的图文消息，合并成一条业务记录
# 例如：
#   5   表示 5 秒内图文会合并
#   60  表示 60 秒内图文会合并
# 当前规则：
#   - 报损：图 + 文字可在窗口内合并
#   - 报账：图片后文字可作为备注合并到同一份报账
#   - 图 + 图：不合并
#   - 一条业务记录最多只会保留一张图片
WECHATY_LOSS_MERGE_WINDOW_SECONDS=60

# 自定义日报提示词模板
# 留空时走代码默认模板
# 如果你要改成单行，注意不要随便带引号
WECHATY_SUMMARY_PROMPT_TEMPLATE=


# =========================
# 报损提取模型配置
# =========================

# 报损提取模型提供商
# 当前已接入：
#   qwen
WECHATY_LOSS_EXTRACTION_PROVIDER=qwen

# 报损提取模型名
# 推荐：
#   qwen3-vl-flash
WECHATY_LOSS_EXTRACTION_MODEL=qwen3-vl-flash

# 百炼 / DashScope API Key
WECHATY_LOSS_EXTRACTION_API_KEY=

# Qwen OpenAI 兼容接口地址
WECHATY_LOSS_EXTRACTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# =========================
# 报账提取模型配置
# =========================

# 报账提取模型提供商
WECHATY_REIMBURSEMENT_EXTRACTION_PROVIDER=qwen

# 报账图片识别模型名
# 推荐：
#   qwen3.5-flash
WECHATY_REIMBURSEMENT_EXTRACTION_MODEL=qwen3.5-flash

# 首次返回空结构化结果时的重试模型
# 默认：
#   qwen3.5-plus
WECHATY_REIMBURSEMENT_EXTRACTION_RETRY_MODEL=qwen3.5-plus

# 百炼 / DashScope API Key
WECHATY_REIMBURSEMENT_EXTRACTION_API_KEY=

# Qwen OpenAI 兼容接口地址
WECHATY_REIMBURSEMENT_EXTRACTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
